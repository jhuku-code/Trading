
# ================================================================================
# JFATL Long/Short Signal Scanner
# ================================================================================
# Scans all coins from the OHLC dataloader for JFATL crossover signals.
# - LONG signals:  price crossed ABOVE JFATL line within the last N bars
# - SHORT signals: price crossed BELOW JFATL line within the last N bars

# JFATL = JMA-smoothed FATL (Fast Adaptive Trendline)
#  Step 1: FATL = SMA(close, fatl_period)
# Step 2: Blend two WMAs of the FATL at different lengths using a phase parameter
#          jfatl = WMA(fatl, jma_period) * e + WMA(fatl, jma_period/2) * (1 - e)
#          where e = 0.5 * (phase + 1)

# Pine Script source: Multi-Indicator Trading Signals_v2 (v6)
# ================================================================================

import streamlit as st
import pandas as pd
import numpy as np

# =================== Page Configuration ===================
st.set_page_config(page_title="JFATL Long/Short", layout="wide")
st.title("JFATL Long/Short Signal Scanner")

# =================== Session State Gate ===================
# All pages read OHLC data from the shared session state key populated by the dataloader page
if "ohlc_multi" not in st.session_state or st.session_state["ohlc_multi"] is None:
    st.warning("⚠️ No OHLC data found in session. Please load data from the **OHLC Dataloader** page first.")
    st.stop()

ohlc_multi = st.session_state["ohlc_multi"]  # dict of {ticker: DataFrame} with OHLC columns


# =================== Helper Functions ===================

def compute_wma(series: pd.Series, period: int) -> pd.Series:
    """
    Weighted Moving Average (WMA) — mirrors Pine Script's ta.wma().
    Weights are linearly increasing: most recent bar gets weight = period,
    second most recent = period-1, etc.
    Returns NaN for bars where insufficient history exists.
    """
    period = int(period)
    if period < 1:
        return series.copy()
    # Linear weights: [1, 2, 3, ..., period]
    weights = np.arange(1, period + 1, dtype=float)
    # Rolling apply using dot product with weights, normalized by weight sum
    return series.rolling(window=period, min_periods=period).apply(
        lambda x: np.dot(x, weights) / weights.sum(), raw=True
    )


def compute_jfatl(close: pd.Series, fatl_period: int, jma_period: int, phase: float) -> pd.Series:
    """
    Compute the JFATL (JMA-smoothed Fast Adaptive Trendline).

    Pipeline (from Pine Script):
      1) fatl = SMA(close, fatl_period)           — baseline trend estimate
      2) e = 0.5 * (phase + 1)                    — blending coefficient [0..1]
      3) jfatl = WMA(fatl, jma_period) * e         — slow WMA component
             + WMA(fatl, jma_period / 2) * (1 - e) — fast WMA component

    The dual-WMA blend controlled by 'phase' lets the user dial between
    a smoother (phase→-1, favoring the fast WMA) and a laggier
    (phase→+1, favoring the slow WMA) trendline.
    """
    # Step 1: FATL = Simple Moving Average of close prices
    fatl = close.rolling(window=fatl_period, min_periods=fatl_period).mean()

    # Step 2: Phase-based blending coefficient
    e = 0.5 * (phase + 1.0)  # phase=0.5 → e=0.75

    # Step 3: Two WMAs of the FATL at different lookback lengths
    wma_slow = compute_wma(fatl, jma_period)               # WMA(fatl, 120) — laggier
    wma_fast = compute_wma(fatl, max(int(jma_period / 2), 1))  # WMA(fatl, 60)  — faster

    # Step 4: Blend
    jfatl = wma_slow * e + wma_fast * (1.0 - e)

    return jfatl


def detect_crossovers(close: pd.Series, jfatl: pd.Series, lookback: int):
    """
    Detect JFATL crossover events within the last `lookback` bars.

    Returns:
        cross_long  (bool): True if close crossed ABOVE jfatl in the window
        cross_short (bool): True if close crossed BELOW jfatl in the window
        cross_bar   (int or None): how many bars ago the most recent cross happened

    Cross-up  (LONG):  close[i] > jfatl[i]  AND  close[i-1] <= jfatl[i-1]
    Cross-down (SHORT): close[i] < jfatl[i]  AND  close[i-1] >= jfatl[i-1]
    """
    cross_long = False
    cross_short = False
    cross_bar = None

    # We need at least lookback+1 bars of valid data to check transitions
    if len(close) < lookback + 1 or len(jfatl) < lookback + 1:
        return cross_long, cross_short, cross_bar

    # Scan from the most recent bar backwards through the lookback window
    for i in range(1, lookback + 1):
        idx_curr = -i           # current bar (starting from latest)
        idx_prev = -(i + 1)    # previous bar

        curr_close = close.iloc[idx_curr]
        prev_close = close.iloc[idx_prev]
        curr_jfatl = jfatl.iloc[idx_curr]
        prev_jfatl = jfatl.iloc[idx_prev]

        # Skip if any value is NaN (insufficient warm-up data)
        if pd.isna(curr_close) or pd.isna(prev_close) or pd.isna(curr_jfatl) or pd.isna(prev_jfatl):
            continue

        # Bullish crossover: price moves from below/at JFATL to above it
        if curr_close > curr_jfatl and prev_close <= prev_jfatl:
            cross_long = True
            if cross_bar is None:
                cross_bar = i  # bars ago the cross happened
            break  # take the most recent signal only

        # Bearish crossover: price moves from above/at JFATL to below it
        if curr_close < curr_jfatl and prev_close >= prev_jfatl:
            cross_short = True
            if cross_bar is None:
                cross_bar = i
            break

    return cross_long, cross_short, cross_bar


# =================== Sidebar Parameters ===================
st.sidebar.header("JFATL Parameters")

# Default values from the user's TradingView settings (screenshots)
fatl_period = st.sidebar.number_input("FATL Period", min_value=2, value=20, step=1,
                                       help="SMA period for the base FATL line")
jma_period = st.sidebar.number_input("JMA Period", min_value=2, value=120, step=1,
                                      help="WMA period for the slow JMA smoothing component")
phase = st.sidebar.number_input("Phase", min_value=-1.0, max_value=1.0, value=0.5, step=0.1,
                                 help="Blending coefficient between fast and slow WMA. "
                                      "+1 = fully slow (laggier), -1 = fully fast (more responsive)")
cross_lookback = st.sidebar.number_input("Crossover Lookback (bars)", min_value=1, value=4, step=1,
                                          help="Number of recent bars to scan for JFATL crossovers")

st.sidebar.markdown("---")
st.sidebar.caption(
    f"**Effective blend:** e = {0.5 * (phase + 1):.2f}  \n"
    f"Slow WMA({jma_period}) × {0.5 * (phase + 1):.2f} + "
    f"Fast WMA({max(int(jma_period / 2), 1)}) × {1 - 0.5 * (phase + 1):.2f}"
)


# =================== Main Computation ===================
long_signals = []   # accumulate LONG crossover results
short_signals = []  # accumulate SHORT crossover results
skipped = []        # coins with insufficient data for JFATL warm-up

# Minimum bars needed: fatl_period + jma_period + crossover lookback
min_bars_required = fatl_period + jma_period + cross_lookback + 1

for ticker, df in ohlc_multi.items():
    # ---- Validate dataframe has required columns ----
    # Normalize column names to lowercase for robustness
    df.columns = [c.lower() for c in df.columns]

    if "close" not in df.columns:
        skipped.append(ticker)
        continue

    close = df["close"].astype(float)

    # ---- Skip coins with insufficient history for indicator warm-up ----
    if len(close) < min_bars_required:
        skipped.append(ticker)
        continue

    # ---- Compute JFATL line ----
    jfatl = compute_jfatl(close, fatl_period, jma_period, phase)

    # ---- Check for valid JFATL at the latest bar ----
    last_close = close.iloc[-1]
    last_jfatl = jfatl.iloc[-1]
    if pd.isna(last_jfatl):
        skipped.append(ticker)
        continue

    # ---- Detect crossovers within the lookback window ----
    is_long, is_short, bars_ago = detect_crossovers(close, jfatl, cross_lookback)

    # ---- % price difference: (close - jfatl) / jfatl × 100 ----
    # Positive = price above JFATL (bullish spread); Negative = price below (bearish spread)
    pct_diff = ((last_close - last_jfatl) / last_jfatl) * 100.0

    if is_long:
        long_signals.append({
            "Coin": ticker,
            "Close": round(last_close, 2),
            "JFATL": round(last_jfatl, 2),
            "Spread %": round(pct_diff, 2),       # how far above JFATL the price is
            "Cross (bars ago)": bars_ago,
        })

    if is_short:
        short_signals.append({
            "Coin": ticker,
            "Close": round(last_close, 2),
            "JFATL": round(last_jfatl, 2),
            "Spread %": round(pct_diff, 2),        # how far below JFATL the price is
            "Cross (bars ago)": bars_ago,
        })


# =================== Display Results ===================

# Summary metrics row
col1, col2, col3 = st.columns(3)
col1.metric("🟢 Long Signals", len(long_signals))
col2.metric("🔴 Short Signals", len(short_signals))
col3.metric("Total Coins Scanned", len(ohlc_multi) - len(skipped))

st.markdown("---")

# ---- LONG Signals Table ----
st.subheader("🟢 LONG Signals — Bullish JFATL Crossovers")
st.caption("Price crossed ABOVE the JFATL line within the lookback window. "
           "Sorted by Spread % (largest first — strongest breakouts on top).")

if long_signals:
    df_long = pd.DataFrame(long_signals)
    # Sort descending by Spread %: largest positive spread = most convincing breakout
    df_long = df_long.sort_values("Spread %", ascending=False).reset_index(drop=True)
    df_long.index += 1  # 1-based ranking
    st.dataframe(df_long, use_container_width=True)
else:
    st.info("No bullish JFATL crossovers detected in the last "
            f"{cross_lookback} bar(s).")

st.markdown("---")

# ---- SHORT Signals Table ----
st.subheader("🔴 SHORT Signals — Bearish JFATL Crossovers")
st.caption("Price crossed BELOW the JFATL line within the lookback window. "
           "Sorted by Spread % (most negative first — deepest breakdowns on top).")

if short_signals:
    df_short = pd.DataFrame(short_signals)
    # Sort ascending by Spread %: most negative spread = deepest breakdown
    df_short = df_short.sort_values("Spread %", ascending=True).reset_index(drop=True)
    df_short.index += 1  # 1-based ranking
    st.dataframe(df_short, use_container_width=True)
else:
    st.info("No bearish JFATL crossovers detected in the last "
            f"{cross_lookback} bar(s).")

# ---- Skipped coins (collapsed) ----
if skipped:
    with st.expander(f"⚠️ {len(skipped)} coin(s) skipped — insufficient data for JFATL warm-up"):
        st.write(", ".join(sorted(skipped)))
        st.caption(f"JFATL requires at least {min_bars_required} bars "
                   f"(FATL {fatl_period} + JMA {jma_period} + lookback {cross_lookback} + 1).")
